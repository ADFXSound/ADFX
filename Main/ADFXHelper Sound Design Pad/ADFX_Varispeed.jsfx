desc:ADFX Varispeed
author: ADFXSound
version: 1.4
tags: sampler varispeed interpolation
// Two paths, one increment:
//   Play=Stopped  — pitch the track input (dual-grain delay, time stays 1:1)
//   Play=Playing  — play the RAM sample the pad (or filename:0) loaded
// Rate is a slewed increment. Pitch is extra semitones on the same head.
// v1.4: Smooth can be 0 (follow on the next sample). Pad Rate/Pitch also
// arrive through gmem so @sample does not wait on SetParam.
// v1.3: Stopped path no longer servo-locks delay back to 1x (that cancelled
// pitch after the pad stopped moving). Live input is now a grain pitch shift.
// v1.2: Delay slider, Xfade on loop splices, anti-alias when Rate > 1.
// Sliders 1–8 are unchanged so LEARN keeps working.

slider1:0<0,1,1{Stopped,Playing}>Play
slider2:1<0.25,4,0.0001>Rate
slider3:0<-24,24,0.001>Pitch (st)
slider4:1<0,1,1{Off,On}>Loop
slider5:8<0,40,0.01>Smooth (ms)
slider6:1<0,4,0.001>Gain
slider7:0<0,1000000,1>-Load
slider8:0<0,1,1>-Has Sample
slider9:80<5,400,1>-Delay (ms)
slider10:4<0,20,0.1>-Xfade (ms)
slider11:0<0,31,1>-Gmem Slot

filename:0,none

options:maxmem=16000000
options:gmem=ADFXVarispeed

@init

MAX_FRAMES = 3000000;
buf_l = 0;
buf_r = MAX_FRAMES;
tmp = MAX_FRAMES * 2;
TMP_FRAMES = 16384;

RING_MAX = 400000;
ring_l = 7000000;
ring_r = 7000000 + RING_MAX;
ring_len = min(srate * 2, RING_MAX);
ring_len < 2048 ? ring_len = 2048;
target_delay = srate * 0.08;
target_delay < 64 ? target_delay = 64;
target_delay > ring_len * 0.4 ? target_delay = ring_len * 0.4;
w = 0;
rp = ring_len - target_delay;
rp_from = rp;
rp_to = rp;
xfade_left = 0;
xfade_total = 1;
ring_fade_n = 0;
loop_fade = 0;

buf_frames = 0;
file_srate = srate;
file_nch = 2;
pos = 0;
rate_now = 1;
env = 0;
was_play = 0;
last_load = -1;
lp_l = 0;
lp_r = 0;
aa_coef = 1;
g0_pha = 0;
g1_pha = 0.5;
g0_rp = rp;
g1_rp = rp;
grain_n = target_delay;
grain_inc = 1 / max(grain_n, 1);
GMEM_MAGIC = 1094991960;

function wrap_index(i, frames)
(
  frames <= 0 ? 0 : (
    i = i % frames;
    i < 0 ? i += frames;
    i;
  );
);

function clamp_index(i, frames)
(
  frames <= 1 ? 0 : (
    i < 0 ? 0 : (
      i > frames - 1 ? frames - 1 : i
    );
  );
);

function wrap_len(x, n)
(
  n <= 0 ? 0 : (
    x >= n ? x -= n;
    x < 0 ? x += n;
    x;
  );
);

function hermite4(y0, y1, y2, y3, t)
(
  c0 = y1;
  c1 = 0.5 * (y2 - y0);
  c2 = y0 - 2.5 * y1 + 2 * y2 - 0.5 * y3;
  c3 = 0.5 * (y3 - y0) + 1.5 * (y1 - y2);
  c0 + (c1 + (c2 + c3 * t) * t) * t;
);

function read_hermite(base, frames, x)
(
  frames <= 1 ? base[0] : (
    i = floor(x);
    t = x - i;
    y0 = base[wrap_index(i - 1, frames)];
    y1 = base[wrap_index(i,     frames)];
    y2 = base[wrap_index(i + 1, frames)];
    y3 = base[wrap_index(i + 2, frames)];
    hermite4(y0, y1, y2, y3, t);
  );
);

function read_hermite_clamp(base, frames, x)
(
  frames <= 1 ? base[0] : (
    i = floor(x);
    t = x - i;
    y0 = base[clamp_index(i - 1, frames)];
    y1 = base[clamp_index(i,     frames)];
    y2 = base[clamp_index(i + 1, frames)];
    y3 = base[clamp_index(i + 2, frames)];
    hermite4(y0, y1, y2, y3, t);
  );
);

function load_file()
(
  fh = file_open(0);
  fh < 0 ? (
    buf_frames = 0;
    slider8 = 0;
    0;
  ) : (
    file_nch = 0;
    file_srate = 0;
    ok_riff = file_riff(fh, file_nch, file_srate);
    ok_riff ? (
      file_nch < 1 ? file_nch = 1;
      file_srate < 1 ? file_srate = srate;
      remain = file_avail(fh);
      remain < 0 ? remain = 0;
      frames = floor(remain / max(file_nch, 1));
      frames > MAX_FRAMES ? frames = MAX_FRAMES;
      dest = 0;
      chunks = floor((frames + TMP_FRAMES - 1) / TMP_FRAMES);
      chunks < 1 ? chunks = 1;
      loop(chunks,
        dest < frames ? (
          n = frames - dest;
          n > TMP_FRAMES ? n = TMP_FRAMES;
          want = n * file_nch;
          got = file_mem(fh, tmp, want);
          got == 1 && want > 1 ? got = want;
          got < 0 ? got = 0;
          nread = floor(got / max(file_nch, 1));
          nread > n ? nread = n;
          k = 0;
          loop(nread,
            buf_l[dest + k] = tmp[k * file_nch];
            file_nch > 1 ? buf_r[dest + k] = tmp[k * file_nch + 1] : buf_r[dest + k] = tmp[k * file_nch];
            k += 1;
          );
          dest += nread;
        );
      );
      buf_frames = dest;
    ) : (
      buf_frames = 0;
    );
    file_close(fh);
    pos = 0;
    rate_now = slider2;
    lp_l = 0;
    lp_r = 0;
    slider8 = buf_frames > 1 ? 1 : 0;
    buf_frames > 1;
  );
);

@slider

slider7 != last_load ? (
  last_load = slider7;
  load_file();
  pos = 0;
  env = 0;
);

@block

want_play = slider1 > 0.5;
want_play && !was_play ? (
  load_file();
  pos = 0;
  env = 0;
  lp_l = 0;
  lp_r = 0;
);
was_play = want_play;
slider4 < 0.5 && pos >= buf_frames && buf_frames > 1 ? slider1 = 0;
slider8 = buf_frames > 1 ? 1 : 0;

smooth_ms = max(slider5, 0);
smooth_ms <= 0 ? (
  rate_coef = 0;
) : (
  rate_coef = exp(-1 / (smooth_ms * 0.001 * srate));
);
env_coef = exp(-1 / (0.006 * srate));

want_delay = slider9 * 0.001 * srate;
want_delay < 64 ? want_delay = 64;
want_delay > ring_len * 0.4 ? want_delay = ring_len * 0.4;
target_delay = target_delay * rate_coef + want_delay * (1 - rate_coef);

xfade_ms = max(slider10, 0);
xfade_n = floor(xfade_ms * 0.001 * srate);
ring_fade_n = xfade_n;
ring_cap = floor(target_delay * 0.25);
ring_fade_n > ring_cap ? ring_fade_n = ring_cap;
ring_fade_n < 0 ? ring_fade_n = 0;

loop_fade = xfade_ms * 0.001 * max(file_srate, 1);
loop_fade > buf_frames * 0.25 ? loop_fade = buf_frames * 0.25;
loop_fade < 0 ? loop_fade = 0;

grain_n = floor(max(slider9, 20) * 0.001 * srate);
grain_n < 64 ? grain_n = 64;
grain_max = floor(ring_len * 0.2);
grain_n > grain_max ? grain_n = grain_max;
grain_inc = 1 / grain_n;

@sample

in_file = slider1 > 0.5 && buf_frames > 1;

sr_ratio = (in_file && file_srate > 0) ? (file_srate / max(srate, 1)) : 1;
in_rate = slider2;
in_pitch = slider3;
gmem_slot = slider11;
gmem_slot < 0 ? gmem_slot = 0;
gmem_slot > 31 ? gmem_slot = 31;
gmem_base = 8 + gmem_slot * 4;
gmem[0] == GMEM_MAGIC && gmem[gmem_base] > 0 ? (
  gmem_flags = gmem[gmem_base + 3];
  gmem_flags % 2 >= 1 ? in_rate = gmem[gmem_base + 1];
  floor(gmem_flags / 2) % 2 >= 1 ? in_pitch = gmem[gmem_base + 2];
);
target_rate = in_rate * pow(2, in_pitch / 12) * sr_ratio;
target_rate < 0.01 ? target_rate = 0.01;
target_rate > 64 ? target_rate = 64;
rate_now = rate_now * rate_coef + target_rate * (1 - rate_coef);

g = slider6;

in_file ? (
  want_env = (slider4 > 0.5 || pos < buf_frames - 1) ? 1 : 0;
  env = env * env_coef + want_env * (1 - env_coef);
  looping = slider4 > 0.5;
  l = read_hermite(buf_l, buf_frames, pos);
  rch = read_hermite(buf_r, buf_frames, pos);
  looping && loop_fade >= 1 && pos >= buf_frames - loop_fade ? (
    fade_t = (pos - (buf_frames - loop_fade)) / loop_fade;
    fade_t < 0 ? fade_t = 0;
    fade_t > 1 ? fade_t = 1;
    la = read_hermite_clamp(buf_l, buf_frames, pos);
    ra = read_hermite_clamp(buf_r, buf_frames, pos);
    lb = read_hermite(buf_l, buf_frames, pos - buf_frames + loop_fade);
    rb = read_hermite(buf_r, buf_frames, pos - buf_frames + loop_fade);
    l = la * (1 - fade_t) + lb * fade_t;
    rch = ra * (1 - fade_t) + rb * fade_t;
  );
  spl0 = l * g * env;
  spl1 = rch * g * env;
  pos += rate_now;
  looping ? (
    pos >= buf_frames ? pos -= buf_frames;
    pos < 0 ? pos += buf_frames;
  ) : (
    pos >= buf_frames ? pos = buf_frames;
  );
) : (
  ring_l[w] = spl0;
  ring_r[w] = spl1;
  w += 1;
  w >= ring_len ? w = 0;

  // Time-preserving pitch: two Hann grains read the delay at rate_now.
  // The old delay-error pull (err * 0.004) cancelled any stable Rate/Pitch
  // and only leaked a warble while the increment was still changing.
  lookback = grain_n * max(rate_now, 1);
  lookback < 64 ? lookback = 64;
  lookback > ring_len * 0.45 ? lookback = ring_len * 0.45;

  g0_pha += grain_inc;
  g0_pha >= 1 ? (
    g0_pha -= 1;
    g0_rp = wrap_len(w - lookback, ring_len);
  );
  g1_pha += grain_inc;
  g1_pha >= 1 ? (
    g1_pha -= 1;
    g1_rp = wrap_len(w - lookback, ring_len);
  );

  win0 = 0.5 - 0.5 * cos(2 * $pi * g0_pha);
  win1 = 0.5 - 0.5 * cos(2 * $pi * g1_pha);
  sl = read_hermite(ring_l, ring_len, g0_rp) * win0
     + read_hermite(ring_l, ring_len, g1_rp) * win1;
  sr = read_hermite(ring_r, ring_len, g0_rp) * win0
     + read_hermite(ring_r, ring_len, g1_rp) * win1;
  g0_rp = wrap_len(g0_rp + rate_now, ring_len);
  g1_rp = wrap_len(g1_rp + rate_now, ring_len);

  spl0 = sl * g;
  spl1 = sr * g;
);

fc = 0.45 * srate / max(rate_now, 1);
aa_coef = 1 - exp(-2 * $pi * fc / max(srate, 1));
aa_coef < 0.0001 ? aa_coef = 0.0001;
aa_coef > 1 ? aa_coef = 1;
lp_l += (spl0 - lp_l) * aa_coef;
lp_r += (spl1 - lp_r) * aa_coef;
spl0 = lp_l;
spl1 = lp_r;

desc: ADFX Recorder Capture
author: ADFX
version: 1.1
about:
  Continuous capture buffer for the ADFX recorder strip.

  REAPER only writes a recording while the transport is rolling, which is no
  use for an instrument that is played live against a stopped project. A JSFX
  has no such limit: @sample runs whenever audio is flowing through the track,
  transport or not. So this plug-in keeps the last few minutes of whatever
  reaches it in a ring buffer, and hands a slice of that buffer to the project
  on request. Nothing here touches the transport.

  It is loaded, configured and driven by ADFX_Recorder_Buffer.lua. There is
  nothing to set by hand.

options:gmem=ADFX_Recorder, maxmem=33554432, gfx_idle=1

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

// Several ADFX scripts can capture at once, each owning one slot of the shared
// memory block. The host script sets this when it loads the plug-in.
slider1:slot=0<0,7,1>Slot
slider2:buffer_seconds=120<5,600,1>Buffer length (seconds)

@init
// Survive transport start: the ring buffer is the whole point of this plug-in
// and REAPER would otherwise clear it every time the user hits play.
ext_noinit = 1;

PROTOCOL = 1;
SLOT_BASE = 64;
SLOT_STRIDE = 32;

// Shared memory layout, relative to this slot's base.
F_HEARTBEAT   = 0;   // time_precise() of the last audio block
F_SRATE       = 1;
F_CAPACITY    = 2;   // ring size in frames
F_FRAMES      = 3;   // frames written since load, never reset
F_PEAK        = 4;   // peak since the host last cleared it
F_PAUSE       = 5;   // host writes 1 to freeze the ring
F_REQUEST     = 6;   // host writes 1 to ask for an export
F_START       = 7;   // first frame to export, absolute
F_LENGTH      = 8;   // frames to export
F_TRACK       = 9;   // destination track index
F_RESULT      = 10;  // 1 done, -1 refused
F_SERIAL      = 11;  // host's request id
F_SERIAL_DONE = 12;  // echoed back when that request is finished
F_PROTOCOL    = 13;

gmem[0] = PROTOCOL;
configure = 1;
// @gfx and @sample can both run before the first @block, and a base of zero
// would write over the shared header rather than this slot.
base = SLOT_BASE + slot * SLOT_STRIDE;

@slider
configure = 1;

@block
(configure || last_srate != srate) ? (
  last_srate = srate;
  base = SLOT_BASE + slot * SLOT_STRIDE;

  // v1.1: exports are intentionally bounded.  Older builds reserved a scratch
  // buffer as large as the entire ring and attempted to export the whole take
  // in one call.  Long stereo exports could create an item with the requested
  // duration but valid samples only through roughly the first memory window.
  // Keep a small fixed scratch area and let the Lua engine request consecutive
  // chunks, then glue those chunks into one user-facing file.
  export_chunk_frames = floor(srate * 20);
  export_chunk_frames > 1048576 ? export_chunk_frames = 1048576;
  export_chunk_frames < 16384 ? export_chunk_frames = 16384;
  scratch_words = export_chunk_frames * 2;
  max_frames = floor((__memtop() - 65536 - scratch_words) / 2);
  cap_frames = floor(buffer_seconds * srate);
  cap_frames > max_frames ? cap_frames = max_frames;
  cap_frames < srate ? cap_frames = srate;

  ring = 0;
  ring_len = cap_frames * 2;
  scratch = ring_len;
  peak = 0;
  locked = 0;

  // Only throw the buffer away when the layout genuinely changed. @init can be
  // re-entered without the RAM having been cleared, and silently restarting
  // the frame counter would strand a take that is being marked.
  cap_frames != last_cap_frames ? (
    wpos = 0;
    frames = 0;
    last_cap_frames = cap_frames;
  );

  gmem[base + F_PROTOCOL] = PROTOCOL;
  gmem[base + F_SRATE] = srate;
  gmem[base + F_CAPACITY] = cap_frames;
  gmem[base + F_FRAMES] = frames;
  gmem[base + F_RESULT] = 0;
  configure = 0;
);

paused = gmem[base + F_PAUSE];

// Published once per block rather than once per sample: the host reads this at
// frame rate and shared memory writes are not free.
gmem[base + F_HEARTBEAT] = time_precise();
gmem[base + F_FRAMES] = frames;
peak > gmem[base + F_PEAK] ? gmem[base + F_PEAK] = peak;
peak = 0;

@sample
(locked == 0 && paused == 0) ? (
  ring[wpos] = spl0;
  ring[wpos + 1] = spl1;
  wpos += 2;
  wpos >= ring_len ? wpos = 0;
  frames += 1;

  a = abs(spl0);
  b = abs(spl1);
  b > a ? a = b;
  a > peak ? peak = a;
);

@gfx 0 0
// Exports have to happen here: export_buffer_to_project may only be called
// from @gfx. options:gfx_idle is what gets this section called while the
// plug-in window is closed, which it always is.
(gmem[base + F_REQUEST] == 1 && cap_frames > 0) ? (
  want_start = gmem[base + F_START];
  want_len = gmem[base + F_LENGTH];
  track_index = gmem[base + F_TRACK];

  // Only what is still in the ring can be exported. Anything older has been
  // overwritten, so clamp rather than hand back the wrong audio.
  oldest = frames - cap_frames;
  oldest < 0 ? oldest = 0;
  want_start < oldest ? (
    want_len -= (oldest - want_start);
    want_start = oldest;
  );
  want_start + want_len > frames ? want_len = frames - want_start;
  // Never hand export_buffer_to_project more than the known-safe scratch size.
  want_len > export_chunk_frames ? want_len = export_chunk_frames;

  want_len > 0 ? (
    locked = 1;
    // Walked rather than taken modulo: the frame counter is absolute and
    // never resets, and EEL's % works on 32 bit integers, so it would wrap
    // after about twelve hours of capture at 48 kHz.
    f = want_start - floor(want_start / cap_frames) * cap_frames;
    i = 0;
    while (i < want_len) (
      scratch[i * 2] = ring[f * 2];
      scratch[i * 2 + 1] = ring[f * 2 + 1];
      f += 1;
      f >= cap_frames ? f = 0;
      i += 1;
    );
    locked = 0;

    export_buffer_to_project(scratch, want_len, 2, srate, track_index, 0, tempo);
    gmem[base + F_RESULT] = 1;
  ) : (
    gmem[base + F_RESULT] = -1;
  );

  gmem[base + F_SERIAL_DONE] = gmem[base + F_SERIAL];
  gmem[base + F_REQUEST] = 0;
);

// Only drawn if someone opens the plug-in by hand.
gfx_ext_flags & 2 ? 0 : (
  gfx_r = 0.8; gfx_g = 0.8; gfx_b = 0.8; gfx_a = 1;
  gfx_x = 8; gfx_y = 8;
  gfx_drawstr("ADFX Recorder capture buffer — driven by the recorder strip");
  gfx_x = 8; gfx_y = 26;
  gfx_drawstr(sprintf(#, "slot %d   %d s   %s", slot, cap_frames / srate,
    paused ? "paused" : "capturing"));
);

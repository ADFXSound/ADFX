old=slider9; slider11<.5 ? slider9=slider4 : slider9=hslider(9,rx+16,top+262,colw-112,slider9,0,100,.1);
slider9=numbox(209,rx+colw-88,top+262,72,slider9,1," %",0,100,.1,slider11>=.5); slider9!=old ? ui_needslider=1;
smalllabel(rx+16,top+295,"SATURATION");
slider11>=.5 && button(140,rx+16,top+314,58,22,"OFF",slider10==0) ? (slider10=0;ui_needslider=1;);

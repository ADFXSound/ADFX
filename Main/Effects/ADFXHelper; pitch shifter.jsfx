slider20<.5 && button(119,lx+232,top+178,48,22,"+24",0) ? (slider2=24;ui_needslider=1;);
button(113,lx+16,top+206,112,22,"PRESERVE",slider3>=.5) ? (slider3=slider3<.5?1:0;ui_needslider=1;);

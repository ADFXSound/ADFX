smalllabel(216,by+14,"OUTPUT"); old=slider13; slider13=hslider(13,216,by+32,82,slider13,-24,12,.1); slider13=numbox(213,304,by+32,60,slider13,1," dB",-24,12,.1,1); slider13!=old?ui_needslider=1;


slider1=numbox(201,lx+colw-88,top+66,72,slider1,2," st",-24,24,slider14>=.5?1:.01,1); slider1!=old ? ui_needslider=1;
button(109,lx+16,top+94,48,22,"-24",0) ? (slider1=-24;ui_needslider=1;);

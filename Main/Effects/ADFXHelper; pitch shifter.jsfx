slider7=numbox(207,rx+colw-88,top+150,72,slider7,2," st",-24,24,.01,slider11>=.5 && slider20<.5); slider7!=old ? ui_needslider=1;
slider11>=.5 && slider20<.5 && button(135,rx+16,top+178,48,22,"-24",0) ? (slider7=-24;ui_needslider=1;);
slider11>=.5 && slider20<.5 && button(136,rx+70,top+178,48,22,"-12",0) ? (slider7=-12;ui_needslider=1;);
slider11>=.5 && slider20<.5 && button(137,rx+124,top+178,48,22,"0",0) ? (slider7=0;ui_needslider=1;);
slider11>=.5 && slider20<.5 && button(138,rx+178,top+178,48,22,"+12",0) ? (slider7=12;ui_needslider=1;);
slider11>=.5 && slider20<.5 && button(139,rx+232,top+178,48,22,"+24",0) ? (slider7=24;ui_needslider=1;);
slider11>=.5 && button(133,rx+16,top+206,112,22,"PRESERVE",slider8>=.5) ? (slider8=slider8<.5?1:0;ui_needslider=1;);
slider11>=.5 ? icon_lock(rx+22,top+209,15,slider8>=.5);


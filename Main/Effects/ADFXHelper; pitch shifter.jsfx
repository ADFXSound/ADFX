icon_power(lx+19,top+318,11,slider5==0); icon_reels(lx+83,top+318,11,slider5==1); icon_tube(lx+147,top+318,11,slider5==2); icon_bolt(lx+211,top+318,11,slider5==3);

// RIGHT pitch
smalllabel(rx+16,top+48,"PITCH");
old=slider6; slider11<.5 ? slider6=slider1 : slider6=hslider(6,rx+16,top+66,colw-112,slider6,-24,24,slider14>=.5?1:.01);
slider6=numbox(206,rx+colw-88,top+66,72,slider6,2," st",-24,24,slider14>=.5?1:.01,slider11>=.5); slider6!=old ? ui_needslider=1;
slider11>=.5 && button(129,rx+16,top+94,48,22,"-24",0) ? (slider6=-24;ui_needslider=1;);
slider11>=.5 && button(130,rx+70,top+94,48,22,"-12",0) ? (slider6=-12;ui_needslider=1;);
slider11>=.5 && button(131,rx+124,top+94,48,22,"0",0) ? (slider6=0;ui_needslider=1;);
